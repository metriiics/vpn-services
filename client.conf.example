[Interface]
PrivateKey = CLIENT_PRIVATE_KEY
Address = 10.77.38.2/32
DNS = 1.1.1.1
MTU = 1280

HeaderProtectionKey = SHARED_HEADER_KEY
S1 = 32
S2 = 32
S3 = 32
S4 = 32
H1 = 1
H2 = 2
H3 = 3
H4 = 4
